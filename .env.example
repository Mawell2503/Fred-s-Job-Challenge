# Copy this file to .env and adjust. .env is git-ignored: never commit real keys.

# ---- LLM used by Clara, Jules (and Remi's optional double-check) ----
# claude_cli = your Claude subscription through Claude Code, installed and logged in on this
#              machine (run `claude` once and sign in). No API key needed. Demo use.
# api        = Anthropic API (set ANTHROPIC_API_KEY)
# ollama     = free local model through Ollama (http://localhost:11434)
LLM_BACKEND=claude_cli
# LLM_MODEL=                 # optional; e.g. a model name for api/ollama
# CLAUDE_BIN=claude          # path to the claude command if it is not on PATH
# ANTHROPIC_API_KEY=
# OLLAMA_URL=http://localhost:11434
# LLM_TIMEOUT=300            # seconds per LLM call
# JULES_WORKERS=3            # how many CVs Jules reads at the same time

# ---- Python ----
# PYTHON_BIN=python3

# ---- Oscar's embeddings (the "meaning" part of Remi's score) ----
# auto = real multilingual model if `sentence-transformers` is installed, else built-in fallback
# CV_EMBED_BACKEND=auto
# CV_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ---- Website ----
# PORT=3000
# ALLOW_SIGNUP=false
