# Copy this file to .env and adjust. .env is git-ignored: never commit real keys.
# Uncomment a line to use it. Keep comments on their own line.

# ---- LLM used by Clara, Jules, the committee, Gaston (and Remi's optional double-check) ----
# claude_cli = your Claude subscription through Claude Code, installed and logged in on this
#              machine (run `claude` once and sign in). No API key needed. Demo use.
# api        = Anthropic API (set ANTHROPIC_API_KEY)
# ollama     = free local model through Ollama (http://localhost:11434)
# fake       = NO AI: plain rules stand in for every agent (tests, offline demo)
LLM_BACKEND=claude_cli

# Optional model name (for api / ollama, or to pick a Claude model)
# LLM_MODEL=
# Path to the claude command if it is not on PATH
# CLAUDE_BIN=claude
# ANTHROPIC_API_KEY=
# OLLAMA_URL=http://localhost:11434
# Seconds per LLM call
# LLM_TIMEOUT=300
# How many CVs Jules reads at the same time
# JULES_WORKERS=3

# ---- Python ----
# PYTHON_BIN=python3

# ---- Oscar's embeddings (the "meaning" part of Remi's score) ----
# auto = real multilingual model if `sentence-transformers` is installed, else built-in fallback
# CV_EMBED_BACKEND=auto
# CV_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ---- Website ----
# PORT=3000
# Sign-up from the login page. Off by default: the very first admin can always sign up,
# after that create admins with `npm run create-admin`. Set to true to leave it open.
# ALLOW_SIGNUP=true
